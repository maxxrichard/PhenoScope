# Copy to .env and adjust. All settings use the PHENOSCOPE_ prefix.
PHENOSCOPE_DATA_ROOT=./data
PHENOSCOPE_DATABASE_URL=sqlite:///./phenoscope.db
# PHENOSCOPE_DATABASE_URL=postgresql+psycopg://phenoscope:phenoscope@localhost:5432/phenoscope
# PHENOSCOPE_MONGO_URL=mongodb://localhost:27017
# PHENOSCOPE_S3_ENDPOINT_URL=http://localhost:9000
PHENOSCOPE_DEVICE=auto
PHENOSCOPE_JOB_BACKEND=local
PHENOSCOPE_MODEL_DIR=./models
PHENOSCOPE_DEFAULT_SEGMENTER=watershed
