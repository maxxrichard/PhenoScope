# GPU worker image: Cellpose, SAM, MONAI U-Net and ViT embeddings on CUDA.
FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 openslide-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
RUN pip install ".[ml,cloud,postgres,wsi]"

# Model weights are pulled from S3 at start-up (see deploy/k8s/base/worker-job.yaml)
ENV PHENOSCOPE_MODEL_DIR=/models
ENTRYPOINT ["phenoscope"]
